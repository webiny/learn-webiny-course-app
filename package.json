{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run generate-mdx-registry && next build",
    "dev": "next dev",
    "dev:watch": "concurrently \"npm run dev\" \"npm run watch-mdx\" --names \"next,watch\" --prefix-colors \"cyan,magenta\"",
    "dev:auto": "npm run generate-mdx-registry && npm run dev:watch",
    "watch-mdx": "node scripts/watch-mdx-lessons.mjs",
    "lint": "eslint .",
    "start": "next start",
    "generate-mdx-registry": "node scripts/generate-mdx-registry.mjs",
    "generate-course-data": "node scripts/generate-course-data.mjs",
    "generate-all": "npm run generate-mdx-registry && npm run generate-course-data"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "latest",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-toast": "1.2.4",
    "@types/mdx": "^2.0.13",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.454.0",
    "mdx": "latest",
    "next": "16.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shiki": "^1.22.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "typescript": "^5"
  }
}
